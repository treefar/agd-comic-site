      ],
      "after": [
        {
          "q": "英文分級免修，學分就不用補了嗎？",
          "a": "仍要補足。113入學起一般日四技英文與外語合計8學分；免修的英文須用規定外語課補。112以前課程結構不同，按自己的入學課表核對；特殊專班另核。",
          "source_ids": [
            "language-course-1130605-listed20240625",
            "language-course-1091209-listed"
          ]
        },
        {
          "q": "本系英文門檻要看哪個標準？",
          "a": "已核112至115入學日四技一般班課表列基本門檻。新版例：CEST為A2；新版TOEIC總分225，且聽力110、閱讀115以上。其他測驗對照全文；特殊專班別直接套用。",
          "source_ids": [
            "english-rule-1141224",
            "curriculum-112",
            "curriculum-113",
            "curriculum-114",
            "curriculum-115"
          ]
        },
        {
          "q": "英文成績一定只能用兩年內的嗎？",
          "a": "114.12.24辦法寫「大學期間或入學前二年內考取之有效證明或成績單」，不是一律從申請日回推兩年。證明仍須有效；自己的考試日期與證明狀態，交承辦確認。",
          "source_ids": [
            "english-rule-1141224"
          ]
        },
        {
          "q": "考過兩次英檢，就算通過門檻嗎？",
          "a": "不算。替代方案還要通過英文能力培養補救課，或至少2學分全英語課且不含校訂必修，再持證明申請。115-1哪些課可用，尚待語教中心確認。",
          "source_ids": [
            "english-rule-1141224"
          ]
        },
        {
          "q": "英文門檻申請要帶什麼？",
          "a": "現列合格表101、替代表102要求簽名表、成績影本，並攜學生證、身分證與成績正本查驗。兩次皆校內英檢免填102紙本；免綁105的適用類別先請承辦核對。",
          "source_ids": [
            "english-forms-listed-20261024",
            "english-rule-1141224"
          ]
        }
