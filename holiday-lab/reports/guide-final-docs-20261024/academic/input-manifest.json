      ],
      "warning": "",
      "faq": [
        {
          "q": "表格送出去，就可以不修那門課嗎？",
          "a": "先確認核准結果，不能把「已送件」當成通過。課表是否需要自行退選，也請在規定期間向系辦或註冊課務組確認。",
          "source_ids": [
            "credit-transfer-115-1",
            "academic-faq"
          ]
        },
        {
          "q": "現在能補交115-1抵免嗎？",
          "a": "公告列2026/8/3至9/21受理，已截止且註明逾期不受理。不要自行假設可補交；有特殊身分或程序疑義，請洽註冊課務組。",
          "source_ids": [
            "credit-transfer-115-1"
          ]
        },
        {
          "q": "抵修和免修一樣嗎？",
          "a": "不一樣。114年9月10日辦法將「抵修」列為採認科目及學分，「免修」只採認科目、不給學分，還要修其他課補足。請核對最後核定類型，不只看那門課是否不用再修。",
          "source_ids": [
            "academic-credit-rule-1140910"
          ]
        }
      ],
      "step_details": [
        {
          "title": "到系統填寫申請並印出紙本",
          "detail": "先確認申請身分與當期截止日，再到校務系統填寫並印表。備妥原校歷年成績單正本及適用的證明，一次整理齊全。",
          "source_ids": [
            "credit-transfer-procedure",
            "credit-transfer-form"
          ]
        },
        {
          "title": "送請開課單位與就讀系所主管初審",
          "detail": "把申請資料交給開課單位與自己就讀的系所主管審查。哪些課程可以抵免，先依這個初審結果確認。",
          "source_ids": [
            "credit-transfer-procedure",
            "credit-transfer-form"
          ]
        },
        {
          "title": "依初審結果自行辦理加退選",
          "detail": "初審通過的課程如果仍在課表裡，要自行處理退選；也一起確認需要補選哪些課。不要等最後核定後才開始處理。",
          "source_ids": [
            "credit-transfer-procedure",
            "credit-transfer-form"
          ]
        },
        {
          "title": "將申請表及證明交註冊課務組",
          "detail": "依規定把經初審的申請表與證明資料交到教務處註冊課務組。資料請一次備齊，送件仍須在當期受理期間內完成。",
          "source_ids": [
            "credit-transfer-procedure",
            "credit-transfer-form"
          ]
        },
        {
          "title": "回到系統查詢核定結果",
          "detail": "送件後回校務系統查詢最後核定情形，再與自己的課表及畢業檢核核對。有落差時，帶結果找註冊課務組確認。",
          "source_ids": [
            "credit-transfer-procedure",
            "credit-transfer-form"
          ]
        }
      ],
