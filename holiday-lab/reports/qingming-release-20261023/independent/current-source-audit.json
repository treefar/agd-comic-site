  "writes": [
    {
      "call": "ctx.ui.text",
      "line": 20,
      "source": "ctx.ui.text('kite-help',W('在原創春日場景放自己的紙鳶。牽線長短與張力會改變高度，角度改變前進速度。讓紙鳶在雲窗內停留一下，再接下一段風；不比飛得最遠。','Fly an original paper kite in a spring scene. Line length and tension change height; angle changes forward speed. Hold the kite in each cloud window, then continue to the next wind. This is not a distance race.','春のオリジナル風景で凧を飛ばします。糸の長さと張りで高さ、角度で前進速度が変化。雲の窓に少し留まり、次の風へ。飛距離競争ではありません。'))"
    },
    {
      "call": "ctx.ui.text",
      "line": 21,
      "source": "ctx.ui.text('kite-status',W('先觀察雲窗，再放飛。','Look at the cloud window, then launch.','雲の窓を見てから、飛ばしましょう。'))"
    },
    {
      "call": "ctx.ui.setText",
      "line": 23,
      "source": "ctx.ui.setText(status,W('看紙鳶和雲窗的位置，飛行中也可調整。','Watch the kite and cloud window. You can adjust while flying.','凧と雲の窓を見ましょう。飛行中も調整できます。'))"
    },
    {
      "call": "ctx.hint",
      "line": 24,
      "source": "ctx.hint(W('已保留前面的紀錄。調整牽線，再放飛這一段。','Earlier frames are kept. Adjust the line and retry this wind.','前の記録は残っています。糸を調整し、この風をやり直しましょう。'))"
    },
    {
      "call": "ctx.setProgress",
      "line": 25,
      "source": "ctx.setProgress(s.phase,3)"
    },
    {
      "call": "ctx.ui.setText",
      "line": 26,
      "source": "ctx.ui.setText(status,W('收下了一格，下一段風換方向了。','One frame is saved. The next wind has changed.','1コマ記録しました。次の風は変わっています。'))"
    },
    {
      "call": "ctx.hint",
      "line": 26,
      "source": "ctx.hint(W('看新的雲窗高度，鬆線或收緊後繼續。','Watch the new window height. Loosen or tighten the line, then continue.','新しい窓の高さを見て、糸を緩めるか張って続けましょう。'))"
    },
    {
      "call": "ctx.ui.setText",
      "line": 26,
      "source": "ctx.ui.setText(status,W('這次沒進雲窗，已回到本段起點。','The kite missed the window and returned to this wind’s start.','窓に入れず、この風の出発点に戻りました。'))"
    }
