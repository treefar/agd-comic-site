// Fixed-step, illustrative spring-wind flight. Not an accurate kite-flight simulator.
export const id='qingming';const W=(zh,en,ja)=>({zh,en,ja});
export const WINDS=[{x:30,y:40,speed:3.5,gust:0},{x:55,y:32,speed:3.2,gust:3},{x:80,y:38,speed:3,gust:-2}].map(Object.freeze);
export const createState=()=>({phase:0,x:10,y:52,vy:0,dwell:0,time:0,ticks:0,accumulator:0,captures:[],path:[{x:10,y:52,phase:0,time:0}],resets:0});
function valid(c){return c&&['angle','length','tension'].every(k=>Number.isFinite(c[k]))&&c.angle>=-30&&c.angle<=30&&c.length>=50&&c.length<=150&&c.tension>=0&&c.tension<=1;}
export function retryStage(state){if(state.phase>=3)return state;return {...state,x:[10,40,65][state.phase],y:52,vy:0,dwell:0,accumulator:0,resets:state.resets+1,path:[...state.path,{x:[10,40,65][state.phase],y:52,phase:state.phase,time:state.time,retry:true}]};}
export function advance(state,c,dt){if(!valid(c)||!Number.isFinite(dt)||dt<0||dt>1||state.phase>=3)return state;let s={...state,path:[...state.path],captures:[...state.captures],accumulator:state.accumulator+dt};
 while(s.accumulator>=.02-1e-10&&s.phase<3){s.accumulator-=.02;s.time+=.02;s.ticks++;const wind=WINDS[s.phase];const aim=50-(c.length-50)*.2-c.tension*25+wind.gust;s.vy+=((aim-s.y)*2-s.vy*1.4)*.02;s.y+=s.vy*.02;s.x+=(wind.speed+c.angle*.04)*.02;
  if(s.ticks%10===0)s.path.push({x:Number(s.x.toFixed(3)),y:Number(s.y.toFixed(3)),phase:s.phase,time:Number(s.time.toFixed(3)),rotation:c.angle/2});
  const inside=Math.abs(s.x-wind.x)<=5&&Math.abs(s.y-wind.y)<=7;s.dwell=inside?s.dwell+.02:0;
  if(s.dwell>=.5-1e-10){s.captures.push({phase:s.phase,point:{x:s.x,y:s.y},controls:{...c},time:s.time});s.phase++;s.dwell=0;}
  else if(s.x>98||s.y<8||s.y>90){s=retryStage(s);break;}
 }return s;}
export function buildResult(s){if(s.phase!==3||s.captures.length!==3)throw Error('Three actual flight captures required');return {score:100,summary:W('三段春風，都留下了自己的飛行軌跡。','Your flight left a record in all three spring winds.','3つの春風で、自分の飛行記録を残せました。'),artifact:{captures:s.captures,path:s.path,resets:s.resets,seconds:Number(s.time.toFixed(2))},replay:s.captures.map((c,i)=>{
 const retry=s.path.filter(p=>p.phase===i&&p.retry).at(-1),previous=s.captures[i-1],start=retry||{...(previous?.point||{x:10,y:52}),time:previous?.time||0,rotation:previous?.controls.angle/2||0};
 const points=[start,...s.path.filter(p=>p.phase===i&&!p.retry&&p.time>start.time&&p.time<c.time),{...c.point,time:c.time,rotation:c.controls.angle/2}],span=Math.max(.02,c.time-start.time);
 const frames=points.map(p=>({at:Math.round((p.time-start.time)/span*2400),x:p.x,y:p.y,rotation:p.rotation??c.controls.angle/2}));
 return {duration:2700,caption:W(`春風第${i+1}段・成功飛行軌跡（縮時）`,`Wind ${i+1} · successful flight (time-lapse)`,`春風${i+1}・成功した飛行（縮時）`),sprites:[{key:`actor${i+1}`,x:start.x,y:start.y,width:17,height:25,rotation:start.rotation??0,frames},{key:'target',x:WINDS[i].x,y:WINDS[i].y,width:12,height:17},{key:'prop2',x:12,y:86,width:15,height:20}]};})};}
export function mount(ctx){let s=createState(),draft={angle:0,length:60,tension:.8},running=false,dead=false;const kite=ctx.sprite('actor1',{id:'kite-body-sprite',x:10,y:52,width:17,height:25,z:4});const target=ctx.sprite('target',{id:'kite-window-sprite',x:WINDS[0].x,y:WINDS[0].y,width:12,height:17});const ribbon=ctx.sprite('prop1',{id:'kite-wind-sprite',x:83,y:15,width:25,height:18});const spool=ctx.sprite('prop2',{id:'kite-spool-sprite',x:12,y:86,width:15,height:20});
 ctx.ui.text('kite-help',W('在原創春日場景放自己的紙鳶。牽線長短與張力會改變高度，角度改變前進速度。讓紙鳶在雲窗內停留一下，再接下一段風；不比飛得最遠。','Fly an original paper kite in a spring scene. Line length and tension change height; angle changes forward speed. Hold the kite in each cloud window, then continue to the next wind. This is not a distance race.','春のオリジナル風景で凧を飛ばします。糸の長さと張りで高さ、角度で前進速度が変化。雲の窓に少し留まり、次の風へ。飛距離競争ではありません。'));
 const status=ctx.ui.text('kite-status',W('先觀察雲窗，再放飛。','Look at the cloud window, then launch.','雲の窓を見てから、飛ばしましょう。'));
 for(const[k,min,max,step,label]of [['angle',-30,30,1,W('牽線角度','Line angle','糸の角度')],['length',50,150,1,W('牽線長度','Line length','糸の長さ')],['tension',0,1,.02,W('牽線張力','Line tension','糸の張り')]])ctx.ui.slider({id:'kite-'+k,label,min,max,step,value:draft[k],onInput:v=>{draft[k]=v;}});
 ctx.ui.button({id:'kite-play',label:W('放飛／繼續這段風','Fly / continue this wind','飛ばす／この風を続ける'),onClick:()=>{if(!dead&&s.phase<3){running=true;ctx.ui.setText(status,W('看紙鳶和雲窗的位置，飛行中也可調整。','Watch the kite and cloud window. You can adjust while flying.','凧と雲の窓を見ましょう。飛行中も調整できます。'));}}});
 ctx.ui.button({id:'kite-retry',label:W('重試這段風','Retry this wind','この風をやり直す'),onClick:()=>{if(dead)return;running=false;s=retryStage(s);draw();ctx.hint(W('已保留前面的紀錄。調整牽線，再放飛這一段。','Earlier frames are kept. Adjust the line and retry this wind.','前の記録は残っています。糸を調整し、この風をやり直しましょう。'));}});
 function draw(){kite.update({x:s.x,y:s.y,rotation:ctx.reducedMotion?0:draft.angle/2});const wind=WINDS[Math.min(s.phase,2)];target.update({x:wind.x,y:wind.y});ribbon.update({rotation:s.phase===1?12:s.phase===2?-8:0});ctx.setProgress(s.phase,3);}
 const off=ctx.onFrame(({dt})=>{if(dead||!running)return;const old=s.phase,resets=s.resets;s=advance(s,draft,Math.max(0,Math.min(.1,dt)));draw();if(s.phase===3){running=false;ctx.sound('success');ctx.complete(buildResult(s));return;}if(s.phase!==old){running=false;ctx.sound('success');ctx.ui.setText(status,W('收下了一格，下一段風換方向了。','One frame is saved. The next wind has changed.','1コマ記録しました。次の風は変わっています。'));ctx.hint(W('看新的雲窗高度，鬆線或收緊後繼續。','Watch the new window height. Loosen or tighten the line, then continue.','新しい窓の高さを見て、糸を緩めるか張って続けましょう。'));}else if(s.resets!==resets){running=false;ctx.sound('error');ctx.ui.setText(status,W('這次沒進雲窗，已回到本段起點。','The kite missed the window and returned to this wind’s start.','窓に入れず、この風の出発点に戻りました。'));}});draw();return {destroy(){dead=true;running=false;off();[kite,target,ribbon,spool].forEach(o=>o.remove());}};}
